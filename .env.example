# Web search for the Add Opportunity modal's "Search by name" feature. Get yours at
# https://brave.com/search/api/ — the free tier covers 2000 queries/month.
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Featherless AI API key — every AI call in the app: discipline filter, chat,
# "Search by name" extraction, and the pasted-listing parser.
# Get a key at https://featherless.ai
FEATHERLESS_API_KEY=your-featherless-api-key

# Postgres connection string for the public scholarship catalog (Render Postgres).
DATABASE_URL=postgresql://user:password@host/dbname

# Firecrawl server-side ingestion. Discovery starts on listing sites; the pipeline
# traces each lead to the funder's own page and files it for review at /admin.
# Values may be comma-, semicolon-, or newline-separated.
FIRECRAWL_API_KEY=your-firecrawl-api-key
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

# Where leads are discovered. These are aggregators on purpose — anything listed
# here is automatically barred from ever being stored as a scholarship's source.
FIRECRAWL_LISTING_URLS=https://www.opportunitiesforafricans.com/category/scholarships/, https://brightscholarship.com/
# Deprecated name for the same setting, still read for older deployments.
FIRECRAWL_SOURCE_URLS=

# Optional Brave queries used to find listing pages beyond the configured set.
# Left empty, discovery uses FIRECRAWL_LISTING_URLS only. Max 5.
FIRECRAWL_SEARCH_QUERIES=

# How many articles to take from each listing page per run (1–50).
FIRECRAWL_PAGES_PER_SOURCE=10

# Credit caps. The allowance is a fixed lifetime pool, not a monthly one, so spend
# is tracked durably in the ingestion_runs table and a run refuses to start once
# the pool is gone. Raise the lifetime figure only when you have actually bought
# more credits.
FIRECRAWL_LIFETIME_CREDIT_BUDGET=10000
FIRECRAWL_RUN_CREDIT_BUDGET=28

# Conservative defaults for low-concurrency Firecrawl plans.
FIRECRAWL_CONCURRENCY=1
FIRECRAWL_REQUEST_TIMEOUT_MS=120000

# Pipeline shape. Every value has a working default; set them only to tune.
#   NEW_CANDIDATES_PER_RUN   leads traced per run (0–200)
#   REFRESH_PER_RUN          existing rows re-checked per run, capped at a quarter
#                            of the run's credits so discovery keeps the majority
#   MAX_CANDIDATE_ATTEMPTS   retries before a stubborn lead is abandoned
#   SEARCH_FALLBACKS_PER_RUN Brave lookups when an article has no outbound link
#   DEADLINE_MS              wall-clock stop, inside the 300-second function limit
INGESTION_NEW_CANDIDATES_PER_RUN=10
INGESTION_REFRESH_PER_RUN=5
INGESTION_MAX_CANDIDATE_ATTEMPTS=4
INGESTION_SEARCH_FALLBACKS_PER_RUN=3
INGESTION_DEADLINE_MS=240000

# Who may approve scraped scholarships into the catalog at /admin. Comma-separated
# email addresses, matched against the signed-in Firebase account's email. SERVER
# ONLY — never prefix with NEXT_PUBLIC_. Unset means nobody is an admin and every
# admin route answers 503: an empty allowlist must never mean everyone.
#
# Reviewer accounts are created by hand in the Firebase console (Authentication →
# Users → Add user) and sign in at /admin/login, which is a separate page from the
# student one and offers no sign-up. Console-created accounts arrive unverified and
# Firebase sends them nothing, so verification is deliberately not required here —
# this allowlist is the control that matters.
ADMIN_EMAILS=you@example.com

# How long after signing in a reviewer may still approve, in minutes (5–10080).
# Firebase refreshes ID tokens hourly on its own, so token expiry is no measure of
# how long a session has been sitting open; this is checked against the token's
# `auth_time` instead. Twelve hours by default: long enough that nobody is bounced
# out mid-review with a card full of hand-typed corrections, short enough that a
# session left open on a borrowed laptop is dead by morning.
ADMIN_SESSION_MAX_AGE_MINUTES=720

# Optional override for the scholarship extraction model.
FEATHERLESS_EXTRACTION_MODEL=Qwen/Qwen2.5-72B-Instruct

# Firebase client config. Project settings > General > Your apps > Web app.
# These ship in the browser bundle by design; Firestore rules are what protect data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web push public key. Project settings > Cloud Messaging > Web Push certificates.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Service account for server-side Firestore/FCM, as a single-line JSON string.
# Project settings > Service accounts > Generate new private key.
# SERVER ONLY — this bypasses Firestore rules. Never prefix it with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Shared secret the Render cron jobs present to every /api/cron/* endpoint.
CRON_SECRET=

