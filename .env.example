# Web search for the Add Opportunity modal's "Search by name" feature. Get yours at
# https://brave.com/search/api/ — the free tier covers 2000 queries/month.
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# Featherless AI API key — every AI call in the app: discipline filter, chat,
# "Search by name" extraction, and the pasted-listing parser.
# Get a key at https://featherless.ai
FEATHERLESS_API_KEY=your-featherless-api-key

# 0G Storage testnet configuration.
NEXT_PUBLIC_OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
NEXT_PUBLIC_SCHOLARSHIP_ROOT_HASH=0x-your-uploaded-root-hash

# Private key for the deployer wallet used only by scripts/upload-scholarships.mjs.
# NEVER expose this in the browser. Get testnet tokens from https://faucet.0g.ai.
OG_TESTNET_PRIVATE_KEY=0x-your-private-key

# Postgres connection string for the public scholarship catalog (Render Postgres).
DATABASE_URL=postgresql://user:password@host/dbname

# Firebase client config. Project settings > General > Your apps > Web app.
# These ship in the browser bundle by design; Firestore rules are what protect data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web push public key. Project settings > Cloud Messaging > Web Push certificates.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Service account for server-side Firestore/FCM, as a single-line JSON string.
# Project settings > Service accounts > Generate new private key.
# SERVER ONLY — this bypasses Firestore rules. Never prefix it with NEXT_PUBLIC_.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Shared secret the Render cron job presents to /api/cron/check-deadlines.
CRON_SECRET=

